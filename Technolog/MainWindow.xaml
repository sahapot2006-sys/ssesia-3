<Window x:Class="Technolog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АГРО - Технолог" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="АГРО" FontSize="18" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,20,0,30"/>

                <Button x:Name="btnDashboard" Content="Главная" Style="{StaticResource MenuButton}" Click="btnDashboard_Click"/>
                <Button x:Name="btnProducts" Content="Продукты" Style="{StaticResource MenuButton}" Click="btnProducts_Click"/>
                <Button x:Name="btnRecipes" Content="Рецептуры" Style="{StaticResource MenuButton}" Click="btnRecipes_Click"/>
                <Button x:Name="btnProcessCards" Content="Техкарты" Style="{StaticResource MenuButton}" Click="btnProcessCards_Click"/>
                <Button x:Name="btnOrders" Content="Заказы" Style="{StaticResource MenuButton}" Click="btnOrders_Click"/>
                <Button x:Name="btnBatches" Content="Партии" Style="{StaticResource MenuButton}" Click="btnBatches_Click"/>
                <Button x:Name="btnExtruder" Content="Экструдер" Style="{StaticResource MenuButton}" Click="btnExtruder_Click"/>
                <Button x:Name="btnDeviations" Content="Отклонения" Style="{StaticResource MenuButton}" Click="btnDeviations_Click"/>
                <Button x:Name="btnReports" Content="Отчёты" Style="{StaticResource MenuButton}" Click="btnReports_Click"/>

                <Button x:Name="btnLogout" Content="Выход" Style="{StaticResource MenuButton}" 
                        Background="#C0392B" Click="btnLogout_Click" Margin="0,40,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#ECF0F1">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>