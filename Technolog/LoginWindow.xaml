<Window x:Class="Technolog.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="АГРО - Модуль технолога" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин" FontSize="14" Margin="0,5,0,3"/>
        <TextBox Grid.Row="2" x:Name="txtLogin" FontSize="14" Height="35"/>

        <TextBlock Grid.Row="3" Text="Пароль" FontSize="14" Margin="0,10,0,3"/>
        <PasswordBox Grid.Row="4" x:Name="txtPassword" FontSize="14" Height="35"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
            <Button x:Name="btnLogin" Content="Войти" Width="100" Height="35" 
                    Background="#27AE60" Foreground="White" Click="btnLogin_Click"/>
            <Button x:Name="btnRegister" Content="Регистрация" Width="100" Height="35" 
                    Margin="15,0,0,0" Click="btnRegister_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtError" Grid.Row="6" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>