<Window x:Class="Technolog.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="650" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Регистрация технолога" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Grid.Row="1" Text="Логин" FontSize="14" Margin="0,5,0,3"/>
            <TextBox Grid.Row="2" x:Name="txtLogin" FontSize="14" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Text="Пароль" FontSize="14" Margin="0,5,0,3"/>
            <PasswordBox Grid.Row="4" x:Name="txtPassword" FontSize="14" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="5" Text="ФИО" FontSize="14" Margin="0,5,0,3"/>
            <TextBox Grid.Row="6" x:Name="txtFullName" FontSize="14" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="7" Text="Email" FontSize="14" Margin="0,5,0,3"/>
            <TextBox Grid.Row="8" x:Name="txtEmail" FontSize="14" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="9" Text="Телефон" FontSize="14" Margin="0,5,0,3"/>
            <TextBox Grid.Row="10" x:Name="txtPhone" FontSize="14" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="11" Text="Отдел" FontSize="14" Margin="0,5,0,3"/>
            <TextBox Grid.Row="12" x:Name="txtDepartment" FontSize="14" Height="30" 
                     Text="Технологический отдел" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnRegister" Content="Зарегистрироваться" Width="160" Height="35" 
                        Background="#27AE60" Foreground="White" FontSize="14" Click="btnRegister_Click"/>
                <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                        Margin="15,0,0,0" FontSize="14" Click="btnCancel_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtError" Grid.Row="14" Foreground="Red" 
                       HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</Window>