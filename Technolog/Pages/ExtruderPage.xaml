<Page x:Class="Technolog.Pages.ExtruderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ExtruderPage"
      Loaded="ExtruderPage_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button x:Name="btnAdd" Content="Новая программа" Width="120" Height="30" 
                    Background="#27AE60" Foreground="White" Click="btnAdd_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgPrograms" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding program_id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding program_name}" Width="150"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding product_name}" Width="150"/>
                <DataGridTextColumn Header="Зоны температуры" Binding="{Binding temperature_zones}" Width="200"/>
                <DataGridTextColumn Header="Скорость шнека" Binding="{Binding screw_speed}" Width="100"/>
                <DataGridTextColumn Header="Подача" Binding="{Binding feeder_rate}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="gridAdd" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="400" Height="320" CornerRadius="5" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="15">
                    <TextBlock Text="Программа экструдера" FontSize="16" FontWeight="Bold"/>
                    <TextBox x:Name="txtProgramName" Margin="0,5" Text=""/>
                    <TextBlock Text="Название программы" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtProductId" Margin="0,5" Text=""/>
                    <TextBlock Text="ID продукта" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtZones" Margin="0,5" Text="80;85;90"/>
                    <TextBlock Text="Зоны температуры" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtScrewSpeed" Margin="0,5" Text="300"/>
                    <TextBlock Text="Скорость шнека (об/мин)" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtFeederRate" Margin="0,5" Text="50"/>
                    <TextBlock Text="Скорость подачи" FontSize="12" Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnSave" Content="Сохранить" Width="100" Click="btnSave_Click"/>
                        <Button x:Name="btnCancel" Content="Отмена" Width="100" Margin="10,0,0,0" Click="btnCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAddError" Foreground="Red"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>