<Page x:Class="Technolog.Pages.DeviationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DeviationsPage"
      Loaded="DeviationsPage_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <TextBlock Text="Фильтр по партии:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtBatchFilter" Width="100" Margin="5,0"/>
            <Button x:Name="btnFilter" Content="Найти" Width="80" Click="btnFilter_Click"/>
            <Button x:Name="btnClear" Content="Сброс" Width="80" Margin="5,0" Click="btnClear_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgDeviations" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding deviation_id}" Width="50"/>
                <DataGridTextColumn Header="Партия" Binding="{Binding batch_id}" Width="80"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="100"/>
                <DataGridTextColumn Header="Серьёзность" Binding="{Binding severity}" Width="100"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding description}" Width="250"/>
                <DataGridTextColumn Header="План" Binding="{Binding planned_value}" Width="80"/>
                <DataGridTextColumn Header="Факт" Binding="{Binding actual_value}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding deviation_date}" Width="150"/>
                <DataGridTextColumn Header="Решение" Binding="{Binding resolution}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtInfo" Margin="5" Foreground="Gray"/>
    </Grid>
</Page>