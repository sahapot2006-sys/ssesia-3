<Page x:Class="Technolog.Pages.BatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BatchesPage"
      Loaded="BatchesPage_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button x:Name="btnAdd" Content="Новая партия" Width="120" Height="30" 
                    Background="#27AE60" Foreground="White" Click="btnAdd_Click"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Height="30" Margin="10,0,0,0"
                    Click="btnRefresh_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgBatches" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding batch_id}" Width="50"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding batch_number}" Width="150"/>
                <DataGridTextColumn Header="ID заказа" Binding="{Binding order_id}" Width="80"/>
                <DataGridTextColumn Header="Старт" Binding="{Binding start_time}" Width="150"/>
                <DataGridTextColumn Header="Финиш" Binding="{Binding end_time}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                <DataGridTextColumn Header="Кол-во факт" Binding="{Binding actual_quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="gridAdd" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="350" Height="180" CornerRadius="5" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="15">
                    <TextBlock Text="Новая партия" FontSize="16" FontWeight="Bold"/>
                    <TextBox x:Name="txtBatchNumber" Margin="0,5" Text=""/>
                    <TextBlock Text="Номер партии" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtOrderId" Margin="0,5" Text=""/>
                    <TextBlock Text="ID заказа" FontSize="12" Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnSave" Content="Сохранить" Width="100" Click="btnSave_Click"/>
                        <Button x:Name="btnCancel" Content="Отмена" Width="100" Margin="10,0,0,0" Click="btnCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAddError" Foreground="Red"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>