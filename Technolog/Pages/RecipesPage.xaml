<Page x:Class="Technolog.Pages.RecipesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RecipesPage"
      Loaded="RecipesPage_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button x:Name="btnAdd" Content="Новая рецептура" Width="120" Height="30" 
                    Background="#27AE60" Foreground="White" Click="btnAdd_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgRecipes" AutoGenerateColumns="False" Margin="5"
                  SelectionChanged="dgRecipes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding recipe_id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="200"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding version}" Width="60"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding created_at}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F0F0F0" Height="180" Margin="5">
            <StackPanel>
                <TextBlock Text="Состав рецептуры" FontWeight="Bold" Margin="5"/>
                <DataGrid x:Name="dgComposition" AutoGenerateColumns="False" Height="150" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Компонент" Binding="{Binding component_name}" Width="150"/>
                        <DataGridTextColumn Header="Доля %" Binding="{Binding percentage}" Width="80"/>
                        <DataGridTextColumn Header="Порядок" Binding="{Binding load_order}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Grid x:Name="gridAdd" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="400" Height="380" CornerRadius="5" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="15">
                    <TextBlock Text="Новая рецептура" FontSize="16" FontWeight="Bold"/>
                    <TextBox x:Name="txtName" Margin="0,5" Text=""/>
                    <TextBlock Text="Название" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtVersion" Margin="0,5" Text="1"/>
                    <TextBlock Text="Версия" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtComponentId" Margin="0,5" Text=""/>
                    <TextBlock Text="ID компонента" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtPercentage" Margin="0,5" Text=""/>
                    <TextBlock Text="Доля %" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="txtLoadOrder" Margin="0,5" Text=""/>
                    <TextBlock Text="Порядок загрузки" FontSize="12" Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnSave" Content="Сохранить" Width="100" Click="btnSave_Click"/>
                        <Button x:Name="btnCancel" Content="Отмена" Width="100" Margin="10,0,0,0" Click="btnCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAddError" Foreground="Red"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>