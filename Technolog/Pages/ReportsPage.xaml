<Page x:Class="Technolog.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ReportsPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F0F0F0" Padding="15" Grid.Row="0" Margin="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Отчёт по партиям" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpFrom" Width="120" Margin="15,0,5,0"/>
                <TextBlock Text="по" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Width="120" Margin="5,0,15,0"/>
                <Button x:Name="btnGenerate" Content="Сформировать" Width="120" Height="30" 
                        Background="#27AE60" Foreground="White" Click="btnGenerate_Click"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgReport" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding batch_number}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding actual_quantity}" Width="100"/>
                <DataGridTextColumn Header="Дата старта" Binding="{Binding start_time}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtInfo" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Foreground="Gray" Visibility="Collapsed" Text="Нет данных"/>
    </Grid>
</Page>