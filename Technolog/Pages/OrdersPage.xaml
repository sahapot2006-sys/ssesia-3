<Page x:Class="Technolog.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OrdersPage"
      Loaded="OrdersPage_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button x:Name="btnAdd" Content="Новый заказ" Width="120" Height="30" 
                    Background="#27AE60" Foreground="White" Click="btnAdd_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgOrders" AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding order_id}" Width="50"/>
                <DataGridTextColumn Header="Номер заказа" Binding="{Binding order_number}" Width="120"/>
                <DataGridTextColumn Header="ID рецептуры" Binding="{Binding recipe_id}" Width="80"/>
                <DataGridTextColumn Header="Кол-во (кг)" Binding="{Binding planned_quantity}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                <DataGridTextColumn Header="Дата старта" Binding="{Binding planned_start_date}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="gridAdd" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="350" Height="250" CornerRadius="5" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="15">
                    <TextBlock Text="Новый заказ" FontSize="16" FontWeight="Bold"/>

                    <TextBlock Text="Номер заказа" FontSize="12" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtOrderNumber" Margin="0,5,0,0" Height="30"/>

                    <TextBlock Text="ID рецептуры" FontSize="12" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtRecipeId" Margin="0,5,0,0" Height="30"/>

                    <TextBlock Text="Количество (кг)" FontSize="12" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtQuantity" Margin="0,5,0,0" Height="30" Text="1000"/>

                    <TextBlock Text="Дата старта" FontSize="12" Foreground="Gray" Margin="0,10,0,0"/>
                    <DatePicker x:Name="dpStartDate" Margin="0,5,0,0" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" 
                                Background="#27AE60" Foreground="White" Click="btnSave_Click"/>
                        <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="30" 
                                Margin="10,0,0,0" Click="btnCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAddError" Foreground="Red" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>