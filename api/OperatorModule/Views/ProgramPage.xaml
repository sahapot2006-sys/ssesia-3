<Page x:Class="OperatorModule.Views.ProgramPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorModule.Views"
        mc:Ignorable="d"
        Title="Программа партии"
      Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: информация о партии и шаги -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" 
                Background="#F8F9FA" CornerRadius="5" Padding="10" Margin="0,0,10,0">

            <StackPanel>
                <!-- Информация о партии -->
                <Border Background="#34495E" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="LotNumberText" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ProductNameText" Foreground="#BDC3C7" FontSize="12"/>
                        <TextBlock x:Name="StatusText" Foreground="#BDC3C7" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Список шагов -->
                <TextBlock Text="Последовательность операций" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <ListBox x:Name="StepsList" Height="400" SelectionChanged="StepsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="2" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Background" Value="#D5F5E3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="#AED6F1"/>
                                                <Setter Property="BorderBrush" Value="#2980B9"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StepNumber}" Width="30" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}" Width="200"/>
                                    <TextBlock Text="{Binding Status}" Width="80" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="StartStepButton" Content="▶ Начать шаг" Width="120" Margin="2"
                            Background="#27AE60" Foreground="White" Click="StartStepButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="CompleteStepButton" Content="✅ Завершить шаг" Width="120" Margin="2"
                            Background="#2980B9" Foreground="White" Click="CompleteStepButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="PauseLotButton" Content="⏸ Пауза" Width="80" Margin="2"
                            Background="#F39C12" Foreground="White" Click="PauseLotButton_Click"/>
                    <Button x:Name="BackButton" Content="← Назад" Width="80" Margin="2"
                            Background="#95A5A6" Foreground="White" Click="BackButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Правая колонка: текущий шаг и параметры -->
        <Border Grid.Row="0" Grid.Column="1" Background="#F8F9FA"  Padding="10" Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="Текущая операция" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock x:Name="CurrentStepNameText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="CurrentStepDescText" TextWrapping="Wrap" Margin="0,5,0,10" Foreground="Gray"/>

                <Border Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel x:Name="ParametersPanel"/>
                </Border>

                <Button x:Name="ReportDeviationButton" Content="⚠ Сообщить об отклонении" 
                        Background="#E74C3C" Foreground="White" Click="ReportDeviationButton_Click"
                        Margin="0,5" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- Телеметрия -->
        <Border Grid.Row="2" Grid.Column="1" Background="#2C3E50" CornerRadius="5" Padding="10" Margin="10,10,0,0">
            <StackPanel>
                <TextBlock Text="📊 Телеметрия оборудования" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TempZ1" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="TempZ2" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="TempZ3" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="TempZ4" Foreground="#BDC3C7" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ScrewSpeed" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="Pressure" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="CurrentLoad" Foreground="#BDC3C7" FontSize="11"/>
                        <TextBlock x:Name="TelemetryTime" Foreground="#7F8C8D" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Page>
