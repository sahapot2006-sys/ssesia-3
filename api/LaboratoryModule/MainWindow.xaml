<Window x:Class="LaboratoryModule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaboratoryModule"
        mc:Ignorable="d"
        Title="Модуль лаборатории - контроль качества"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔬 Модуль лаборатории" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text=" | Контроль качества сырья и продукции" FontSize="14" Foreground="#BDC3C7" Margin="10,5,0,0"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <StatusBar Grid.Row="2" Background="#ECF0F1" Padding="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов" Foreground="#2C3E50"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
