<Page x:Class="LaboratoryModule.Views.LabTestPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaboratoryModule.Views"
        mc:Ignorable="d"
        Title="Лабораторное испытание"
      Background="White">

    <Grid Margin="10" Height="245" Width="366">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34495E" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="LotInfoText" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="ProductInfoText" Foreground="#BDC3C7"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="ParametersPanel" Margin="0,10"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="BackButton" Content="Назад" Width="100" Margin="5" Click="BackButton_Click"/>
            <Button x:Name="CompleteButton" Content="Завершить испытание" Width="180" Margin="5"
                    Background="#27AE60" Foreground="White" Click="CompleteButton_Click"/>
        </StackPanel>
    </Grid>
</Page>