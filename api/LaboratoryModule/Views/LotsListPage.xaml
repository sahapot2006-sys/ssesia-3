<Page x:Class="LaboratoryModule.Views.LotsListPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaboratoryModule.Views"
        mc:Ignorable="d"
       Title="Партии на контроль"
      Background="White" Height="239">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Тип партии:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="TypeFilter" Width="150" SelectionChanged="TypeFilter_SelectionChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Сырье"/>
                <ComboBoxItem Content="Готовая продукция"/>
            </ComboBox>

            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Ожидают"/>
                <ComboBoxItem Content="В процессе"/>
                <ComboBoxItem Content="Допущены"/>
                <ComboBoxItem Content="Заблокированы"/>
            </ComboBox>

            <Button x:Name="RefreshButton" Content="Обновить" Width="100" Margin="20,0,0,0"
                    Click="RefreshButton_Click" Background="#3498DB" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="LotsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionChanged="LotsGrid_SelectionChanged"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding LotNumber}" Width="150"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="250"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding LabStatus}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Причина блокировки" Binding="{Binding BlockReason}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="StartTestButton" Content="Начать испытание" Width="150" Margin="5"
                    Background="#27AE60" Foreground="White" Click="StartTestButton_Click" IsEnabled="False"/>
            <Button x:Name="ViewHistoryButton" Content="История" Width="100" Margin="5"
                    Background="#95A5A6" Foreground="White" Click="ViewHistoryButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
    </Page>
